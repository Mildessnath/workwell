# WorkWell frontend — copy to .env.local and fill in. Vite exposes VITE_* vars to the browser.
# ONLY the public anon key belongs here. NEVER put the service-role key in this file.

# Supabase -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=

# Must match DEVICE_ID used by the MQTT subscriber and the ESP32 topics
VITE_WORKWELL_DEVICE_ID=device01

# Initial data mode when the user has not chosen one: demo | real
VITE_DEFAULT_DATA_MODE=demo
