# WorkWell MQTT subscriber — copy to .env and fill in. NEVER commit .env.

# --- HiveMQ Cloud (Cluster -> Overview / Access Management) ---
MQTT_HOST=your-cluster-id.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
# Unique per running subscriber instance
MQTT_CLIENT_ID=workwell-subscriber-01

# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=https://your-project-ref.supabase.co
# Server-side ONLY. Bypasses RLS. Never put this in the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# --- Behaviour ---
DEVICE_ID=device01
# Mark the device offline if no environment message arrives for this long
STALE_AFTER_SECONDS=30
# How often thresholds are re-read from Supabase
THRESHOLD_REFRESH_SECONDS=60
LOG_LEVEL=INFO
